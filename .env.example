# TrendingHub 环境变量配置示例
# 复制此文件为 .env 并修改为实际值

# API 服务端口
APP_PORT=9000

# PostgreSQL 连接字符串（生产环境务必启用 sslmode=require 并使用强密码）
POSTGRES_DSN=host=localhost user=trendinghub password=CHANGE_ME dbname=trendinghub port=5432 sslmode=disable TimeZone=UTC

# Redis 地址
REDIS_ADDR=localhost:6380

# 定时采集 cron 表达式（默认每 30 分钟）
CRON_SPEC=*/30 * * * *

# 黄金价格 API 地址（可选，仅允许 data-asg.goldprice.org / data-goldprice.org）。失败时自动用东方财富沪金主连备用
# GOLD_API_URL=https://data-asg.goldprice.org/dbXRates/CNY
# 金价备用源：东方财富沪金合约 secid（默认 113.888 沪金主连），与 A 股共用 push2.eastmoney.com 接口
# GOLD_EASTMONEY_SECID=113.888

# browser-scraper 服务端口
# PORT=4000
